# Relative paths are resolved from the directory where the server starts.
# Run python -m scripts.prepare_yolov5 before starting the original YOLOv5 backend.
# COCO pretrained model: deployment smoke test only, NOT trained to identify weeds.
WEED_BACKEND=yolov5
WEED_YOLOV5_REPO=vendor/yolov5
WEED_MODEL_PATH=models/yolov5n-seg.pt
# Optional release label; otherwise filename + SHA-256 prefix identifies the weights.
# WEED_MODEL_VERSION=lawn-weeds-v1
WEED_DEVICE=cpu
WEED_HALF=false
WEED_CONFIDENCE=0.25
WEED_IOU_THRESHOLD=0.45
WEED_IMAGE_SIZE=640
WEED_MAX_DETECTIONS=100
WEED_MAX_UPLOAD_BYTES=10485760
WEED_MAX_IMAGE_PIXELS=12000000
WEED_CALIBRATION_DIR=calibrations
WEED_MAX_SENSOR_SKEW_MS=50
