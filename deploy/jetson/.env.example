WEED_BACKEND=yolov5
WEED_CALIBRATION_DIR=calibrations
WEED_MAX_SENSOR_SKEW_MS=50
WEED_YOLOV5_REPO=vendor/yolov5
# Start with PyTorch; switch to models/yolov5n-seg.engine after target-device export.
# Keep the generated .engine.json sidecar next to every .engine.
WEED_MODEL_PATH=models/yolov5n-seg.pt
WEED_DEVICE=0
WEED_HALF=true
WEED_CONFIDENCE=0.25
WEED_IOU_THRESHOLD=0.45
WEED_IMAGE_SIZE=640
WEED_MAX_DETECTIONS=100
WEED_MAX_UPLOAD_BYTES=10485760
WEED_MAX_IMAGE_PIXELS=3000000
